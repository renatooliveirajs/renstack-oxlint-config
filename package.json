{
  "name": "@renstack/oxlint-config",
  "version": "0.1.1",
  "description": "Configurações compartilhadas de Oxlint e Oxfmt para Next.js, React e Node.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renatooliveirajs/renstack-oxlint-config.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/lint.d.ts",
      "default": "./src/base.js"
    },
    "./base": {
      "types": "./src/lint.d.ts",
      "default": "./src/base.js"
    },
    "./react": {
      "types": "./src/lint.d.ts",
      "default": "./src/react.js"
    },
    "./next": {
      "types": "./src/lint.d.ts",
      "default": "./src/next.js"
    },
    "./node": {
      "types": "./src/lint.d.ts",
      "default": "./src/node.js"
    },
    "./oxfmt": {
      "types": "./src/format.d.ts",
      "default": "./src/oxfmt.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc",
    "test": "node --test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
